# Resend API Key: Required for real transactional email delivery to rob@olelohonua.com
# Obtain your free API key at https://resend.com
RESEND_API_KEY=""

# Destination email where inquiries are sent
CONTACT_EMAIL="rob@olelohonua.com"

# Verified sender email address in Resend (e.g. inquiries@olelohonua.com or onboarding@resend.dev during testing)
EMAIL_FROM="Olelo Honua <onboarding@resend.dev>"

# Production site URL
SITE_URL="https://olelohonua.com"

# Optional Google Analytics 4 / Plausible ID
VITE_ANALYTICS_ID=""

# Server Port (automatically set by Render)
PORT=3000

# Node environment
NODE_ENV="production"

# GEMINI_API_KEY: Optional / AI Studio default
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Cloud Run / Hosting service URL
APP_URL="MY_APP_URL"
